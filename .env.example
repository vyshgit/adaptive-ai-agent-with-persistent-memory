# Optional: copy to .env.local. npm scripts load .env, then .env.local.
# Never commit credentials or use VITE_* for secrets. No file is needed to start.
HOST=127.0.0.1
PORT=3000
RECALLLOOP_ENABLE_DEMO=true
RECALLLOOP_CAPTURE_MODE=both

# WALLET WORKSPACE: sign in and enter YOUR Tatum, MemWal delegate, and model
# credentials in Settings. Environment owner credentials below are NEVER inherited
# by wallet workspaces. Browser API forms and key-redaction buffers are tab memory
# only; the server connection expires after one hour. Never enter a wallet key.
# npm run dev:demo opens an explicit mock path; leaving it clears its mock memory.

# OPERATOR POLICY (also applies to browser connections).
# Remote hosting requires an explicit SAME-origin public URL, localhost, or a
# workspace bearer gate. HTTPS proxies must preserve Host and use this allowlist.
# RECALLLOOP_ALLOWED_ORIGINS=https://recallloop.example
# RECALLLOOP_WORKSPACE_TOKEN=use-a-random-secret-of-at-least-32-characters
# RECALLLOOP_REQUIRE_WORKSPACE_AUTH=true
# Setting REQUIRE_WORKSPACE_AUTH=true without a token intentionally locks the API.
# Turn off RECALLLOOP_ENABLE_DEMO for a live-only deployment.

# Supported providers are built in; extra hosts are explicit operator trust grants.
# AGENT_LLM_ALLOWED_HOSTS=your-trusted-provider.example
# AGENT_LLM_ALLOW_LOCAL=true
# Local model URLs point to THIS SERVER's loopback interface, not a remote user's PC.
# AGENT_LLM_MAX_OUTPUT_TOKENS=4000
# Legitimate attribution/OpenAI organisation headers only; no client impersonation.
# AGENT_LLM_EXTRA_HEADERS={"X-Title":"RecallLoop"}

# SEPARATE CLI / EXTERNAL-AGENT MEMORY CONFIGURATION (not wallet UI defaults).
# Leave unset to keep the external memory API unconfigured. For external mock tests:
# RECALLLOOP_MEMORY_MODE=mock
# For live Mainnet seeding, explicitly configure ALL of the following:
# RECALLLOOP_MEMORY_MODE=relayer
# WALRUS_NETWORK=mainnet
# MEMWAL_PRIVATE_KEY=
# MEMWAL_DELEGATE_KEY=               # accepted alias; use one key variable
# MEMWAL_ACCOUNT_ID=
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# RECALLLOOP_AGENT_ID=recallloop-workspace
# TATUM_API_KEY=                     # Mainnet key for HTTP GraphQL observations
# TATUM_API_BASE=https://api.tatum.io # legacy/CLI policy only; wallet host is fixed

# CLI LIVE MODEL CONFIGURATION: no browser cookie/connection is reused.
# RECALLLOOP_LLM_MODE=live
# AGENT_LLM_BASE_URL=https://agentrouter.org/v1
# AGENT_LLM_API_KEY=
# AGENT_LLM_MODEL=gpt-6.1-sol
# AGENT_LLM_API_STYLE=responses       # or chat for Chat Completions providers
# AGENT_MODELS=gpt-6.1-sol
# AGENT_LLM_TOOLS=off                 # enable on only for a compatible tool model
# AgentRouter may require app/client approval. RecallLoop does not spoof clients.
# npm run demo:agent stays mock even with these credentials. Live is opt-in:
# npm run demo:agent -- --live --confirm-live-writes
# npm run seed:memory -- --confirm-mainnet [--wallet-address 0xADDRESS]
#   [--evidence NEW_FILE.md]          # exclusive export; never overwrites a file

# EXTERNAL/LEGACY API AUTH: independent of wallet login. Random 32+ character keys.
# RECALLLOOP_API_KEYS={"external-agent":"use-a-random-secret-of-at-least-32-characters"}
# RECALLLOOP_ADMIN_API_KEY=use-a-different-random-secret-of-at-least-32-characters
# Required for their respective routes in production; dev without keys is local-only.
# Legacy /api/walrus defaults to Testnet and a local index. It is NOT wallet memory
# or Mainnet evidence. No new runtime storage uses that index.

{
  "name": "recallloop",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "dev:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs --demo",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs --production",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:memory": "node --test tests/memory-*.test.mjs",
    "test:agent": "node --test tests/agent-*.test.mjs",
    "test:browser": "playwright test",
    "demo:agent": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/memory-agent-demo.mjs",
    "seed:memory": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-mainnet-memories.mjs",
    "test:auth": "node --test tests/agent-auth.test.mjs",
    "test:visibility": "node --test tests/memory-visibility.test.mjs",
    "test:admin-auth": "node --test tests/admin-auth.test.mjs",
    "test:retrieval": "node --test tests/memory-retrieval.test.mjs tests/retrieval-benchmark.test.mjs",
    "benchmark:retrieval": "node scripts/retrieval-benchmark.mjs",
    "evaluate:retrieval": "node scripts/retrieval-evaluation.mjs",
    "test:vector-candidate": "node --test tests/vector-retrieval-candidate.test.mjs",
    "test:embedding-provider": "node --test tests/openai-embedding-provider.test.mjs",
    "evaluate:vector": "node scripts/evaluate-vector-retrieval.mjs"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.10",
    "@mysten/sui": "^2.37.0",
    "@mysten/wallet-standard": "^0.21.35",
    "@vitejs/plugin-react": "^5.2.0",
    "@wallet-standard/app": "^1.1.1",
    "effect": "4.1.0",
    "express": "^4.22.3",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.30.2",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "google-auth-library": {
      "gcp-metadata": "8.1.2"
    },
    "zod": "^4.6.6"
  }
}
